{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jin-Aladdin/aladdin-spec/blob/main/schemas/translation.schema.json",
  "title": "Aladdin Knowledge Translation",
  "description": "Normative schema for a translation record in an Aladdin Knowledge Pack. A translation connects translated content to the original object it came from, together with the method, the responsible translator or model and the review status. A language variant is never independent knowledge: it always points back at its original, so a consumer can tell a human translation from an unreviewed machine translation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "original_id",
    "field",
    "source_language",
    "target_language",
    "content",
    "method",
    "review_status",
    "status",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^translation:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 15,
      "maxLength": 240,
      "description": "Stable namespaced identifier beginning with translation:."
    },
    "original_id": {
      "$ref": "#/$defs/translatableId",
      "description": "The object this record translates. A translation without an original is not a translation."
    },
    "field": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 2,
      "maxLength": 80,
      "description": "Field of the original object that was translated, for example statement, name or preferred_label."
    },
    "source_language": {
      "$ref": "#/$defs/languageTag"
    },
    "target_language": {
      "$ref": "#/$defs/languageTag"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "description": "The translated text."
    },
    "original_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Hash of the exact original text this translation was made from. Lets a consumer detect that the original changed after translation."
    },
    "method": {
      "type": "string",
      "enum": [
        "human",
        "machine",
        "machine-post-edited",
        "locale-adaptation",
        "imported"
      ],
      "description": "How the translation was produced. machine-post-edited means a machine translation that a human corrected."
    },
    "translator": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200,
      "description": "Person or organization responsible. Required for human and post-edited translation."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version"
      ],
      "description": "Required for machine and post-edited translation, so an automated translation stays attributable.",
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "transformation_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "automatically-checked",
        "human-reviewed"
      ],
      "description": "Review is tracked separately from method. A human translator does not make the result reviewed, and a machine translation can be reviewed."
    },
    "reviewer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "semantic_equivalence": {
      "type": "string",
      "enum": [
        "equivalent",
        "approximate",
        "adapted",
        "divergent",
        "unassessed"
      ],
      "description": "How closely the translation matches the original meaning. adapted means it was deliberately changed for the target locale; divergent means a known meaning difference that a consumer must not ignore."
    },
    "notes": {
      "type": "string",
      "maxLength": 3000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "outdated",
        "superseded",
        "withdrawn"
      ],
      "description": "outdated means the original changed after this translation was made."
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/translationId"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 100
    },
    "withdrawal_reason": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension data using reverse-DNS keys.",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "description": "Machine and post-edited translation must name the model.",
      "if": {
        "properties": {
          "method": {
            "enum": [
              "machine",
              "machine-post-edited"
            ]
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "required": [
          "model"
        ]
      }
    },
    {
      "description": "Human and post-edited translation must name the person responsible.",
      "if": {
        "properties": {
          "method": {
            "enum": [
              "human",
              "machine-post-edited",
              "locale-adaptation"
            ]
          }
        },
        "required": [
          "method"
        ]
      },
      "then": {
        "required": [
          "translator"
        ]
      }
    },
    {
      "description": "A reviewed translation must name the reviewer and the time.",
      "if": {
        "properties": {
          "review_status": {
            "const": "human-reviewed"
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "required": [
          "reviewer",
          "reviewed_at"
        ]
      }
    },
    {
      "description": "A divergent or adapted translation must explain the difference.",
      "if": {
        "properties": {
          "semantic_equivalence": {
            "enum": [
              "adapted",
              "divergent"
            ]
          }
        },
        "required": [
          "semantic_equivalence"
        ]
      },
      "then": {
        "required": [
          "notes"
        ]
      }
    },
    {
      "description": "A superseded translation must name its replacement.",
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "superseded_by"
        ]
      }
    },
    {
      "description": "A withdrawn translation must say why.",
      "if": {
        "properties": {
          "status": {
            "const": "withdrawn"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "withdrawal_reason"
        ]
      }
    }
  ],
  "$comment": "A translation must change language. JSON Schema cannot compare two sibling values, so the reference validator enforces that source_language and target_language differ.",
  "$defs": {
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47-style language tag."
    },
    "translatableId": {
      "type": "string",
      "pattern": "^(?:claim|entity|concept|evidence|relation):[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "translationId": {
      "type": "string",
      "pattern": "^translation:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    }
  }
}
