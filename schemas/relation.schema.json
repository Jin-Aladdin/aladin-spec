{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Jin-Aladdin/aladdin-spec/v0.3.0/schemas/relation.schema.json",
  "title": "Aladdin Knowledge Relation",
  "description": "Normative schema for a typed relation between canonical objects in an Aladdin Knowledge Pack. A relation connects entities, concepts or claims using a defined type or an explicitly namespaced extension type. A relation records that a connection was asserted and by which material it is supported. It does not assert that the connection is true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "from",
    "to",
    "status",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^relation:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 12,
      "maxLength": 240,
      "description": "Stable namespaced identifier beginning with relation:."
    },
    "type": {
      "description": "Relation type. Either a defined core type or a reverse-DNS namespaced extension type, for example org.example.medical:contraindicates.",
      "oneOf": [
        {
          "$ref": "#/$defs/coreRelationType"
        },
        {
          "$ref": "#/$defs/extensionRelationType"
        }
      ]
    },
    "from": {
      "$ref": "#/$defs/connectableId",
      "description": "Subject of the relation."
    },
    "to": {
      "$ref": "#/$defs/connectableId",
      "description": "Object of the relation."
    },
    "symmetric": {
      "type": "boolean",
      "description": "True when the relation holds equally in both directions. A symmetric relation must not be duplicated in the reverse direction as a separate record.",
      "default": false
    },
    "qualifier": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scope in which this relation holds. A relation that is only true for one version or one jurisdiction must say so rather than being asserted unconditionally.",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version_range": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Estimated certainty that this relation holds. Confidence is not equivalent to human review or to verified truth."
    },
    "source_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceId"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 100
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceId"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 500
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claimId"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 200,
      "description": "Claims that assert or discuss this relation."
    },
    "conflict_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflictId"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 100
    },
    "provenance": {
      "type": "string",
      "enum": [
        "unsourced",
        "source-linked",
        "source-backed",
        "evidence-backed",
        "inferred"
      ],
      "description": "How this relation is supported. Provenance describes the supporting material and is independent from the lifecycle status and from the confidence value. inferred means the relation was derived rather than read from a source, and must record the derivation."
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "description": "How an inferred relation was produced. Required when the provenance is inferred, so a derived relation can never be mistaken for a sourced one.",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "transitive-closure",
            "inverse-of-declared",
            "structural-extraction",
            "rule-based",
            "model-assisted"
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "version"
          ],
          "description": "Required for model-assisted derivation. Model output is an untrusted candidate and must remain attributable.",
          "properties": {
            "identity": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "transformation_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        },
        "derived_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "automatically-checked",
            "human-reviewed"
          ]
        }
      }
    },
    "valid_from": {
      "$ref": "#/$defs/dateOrDateTime"
    },
    "valid_until": {
      "$ref": "#/$defs/dateOrDateTime"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "provisional",
        "disputed",
        "superseded",
        "deprecated",
        "invalidated"
      ]
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationId"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 100
    },
    "invalidation_reason": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "notes": {
      "type": "string",
      "maxLength": 3000
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension data using reverse-DNS keys.",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "description": "An inferred relation must record how it was derived.",
      "if": {
        "properties": {
          "provenance": {
            "const": "inferred"
          }
        },
        "required": [
          "provenance"
        ]
      },
      "then": {
        "required": [
          "derivation"
        ]
      }
    },
    {
      "description": "Model-assisted derivation must remain attributable to a model.",
      "if": {
        "properties": {
          "derivation": {
            "properties": {
              "method": {
                "const": "model-assisted"
              }
            },
            "required": [
              "method"
            ]
          }
        },
        "required": [
          "derivation"
        ]
      },
      "then": {
        "properties": {
          "derivation": {
            "required": [
              "model",
              "review_status"
            ]
          }
        }
      }
    },
    {
      "description": "Source-supported provenance requires source references.",
      "if": {
        "properties": {
          "provenance": {
            "enum": [
              "source-linked",
              "source-backed"
            ]
          }
        },
        "required": [
          "provenance"
        ]
      },
      "then": {
        "required": [
          "source_ids"
        ]
      }
    },
    {
      "description": "Evidence-supported provenance requires evidence references.",
      "if": {
        "properties": {
          "provenance": {
            "const": "evidence-backed"
          }
        },
        "required": [
          "provenance"
        ]
      },
      "then": {
        "required": [
          "evidence_ids"
        ]
      }
    },
    {
      "description": "A disputed relation must point at the disagreement.",
      "if": {
        "properties": {
          "status": {
            "const": "disputed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "conflict_ids"
        ]
      }
    },
    {
      "description": "A superseded relation must name its replacement.",
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "superseded_by"
        ]
      }
    },
    {
      "description": "An invalidated relation must say why.",
      "if": {
        "properties": {
          "status": {
            "const": "invalidated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "invalidation_reason"
        ]
      }
    }
  ],
  "$defs": {
    "coreRelationType": {
      "type": "string",
      "enum": [
        "is-a",
        "instance-of",
        "subclass-of",
        "part-of",
        "has-part",
        "depends-on",
        "required-by",
        "uses",
        "used-by",
        "implements",
        "implemented-by",
        "defines",
        "defined-by",
        "specifies",
        "specified-by",
        "publishes",
        "published-by",
        "authored-by",
        "maintained-by",
        "located-in",
        "precedes",
        "follows",
        "supersedes",
        "superseded-by",
        "derived-from",
        "equivalent-to",
        "related-to",
        "conflicts-with",
        "compatible-with",
        "incompatible-with",
        "documented-in",
        "governed-by"
      ]
    },
    "extensionRelationType": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+:[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 200,
      "description": "Reverse-DNS namespaced extension type. An extension type must not redefine the meaning of a core type."
    },
    "connectableId": {
      "type": "string",
      "pattern": "^(?:entity|concept|claim):[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240,
      "description": "Identifier of an entity, concept or claim."
    },
    "relationId": {
      "type": "string",
      "pattern": "^relation:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "claimId": {
      "type": "string",
      "pattern": "^claim:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "sourceId": {
      "type": "string",
      "pattern": "^source:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^evidence:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "conflictId": {
      "type": "string",
      "pattern": "^conflict:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "dateOrDateTime": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    }
  }
}
