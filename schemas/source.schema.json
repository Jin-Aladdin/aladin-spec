{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jin-Aladdin/aladdin-spec/blob/main/schemas/source.schema.json",
  "title": "Aladdin Knowledge Source",
  "description": "Normative schema for a source record referenced by claims, evidence, entities, relations and other Aladdin Knowledge Pack objects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "title",
    "publisher",
    "retrieved_at",
    "language",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^source:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 10,
      "maxLength": 200,
      "description": "Stable namespaced identifier beginning with source:."
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 80,
      "description": "Machine-readable source classification, for example primary-project-documentation, research-paper or official-standard."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "publisher": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "canonical_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "archived_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "doi": {
      "type": "string",
      "pattern": "^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$",
      "maxLength": 200
    },
    "isbn": {
      "type": "string",
      "pattern": "^(?:ISBN(?:-1[03])?:?\\s*)?(?=[0-9Xx -]{10,25}$)[0-9Xx -]+$",
      "maxLength": 32
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "edition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "published_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "updated_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "$ref": "#/$defs/languageTag"
    },
    "license": {
      "$ref": "#/$defs/licenseExpression"
    },
    "license_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 hash of the exact retrieved source content."
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
      "maxLength": 120
    },
    "authority": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "tertiary",
        "user-provided",
        "generated",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "unavailable",
        "superseded",
        "disputed",
        "withdrawn"
      ],
      "default": "active"
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "access_method": {
      "type": "string",
      "enum": [
        "manual",
        "automated-fetch",
        "api",
        "repository-import",
        "file-import",
        "user-upload",
        "other"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension data using reverse-DNS keys.",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "anyOf": [
    {
      "required": [
        "url"
      ]
    },
    {
      "required": [
        "canonical_url"
      ]
    },
    {
      "required": [
        "doi"
      ]
    },
    {
      "required": [
        "isbn"
      ]
    },
    {
      "required": [
        "external_id"
      ]
    },
    {
      "required": [
        "content_hash"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "archived"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "archived_url"
            ]
          },
          {
            "required": [
              "content_hash"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "notes"
        ]
      }
    }
  ],
  "$defs": {
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47-style language tag."
    },
    "licenseExpression": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200,
      "description": "SPDX license identifier, SPDX expression or documented license status."
    }
  }
}
