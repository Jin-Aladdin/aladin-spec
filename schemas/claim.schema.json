{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Jin-Aladdin/aladdin-spec/blob/main/schemas/claim.schema.json",
  "title": "Aladdin Knowledge Claim",
  "description": "Normative schema for a canonical claim record in an Aladdin Knowledge Pack. A claim represents a definition, fact, procedure, observation, interpretation, hypothesis, warning, constraint or recommendation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "statement",
    "language",
    "status",
    "confidence",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^claim:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 9,
      "maxLength": 240,
      "description": "Stable namespaced identifier beginning with claim:."
    },
    "kind": {
      "type": "string",
      "enum": [
        "factual",
        "definition",
        "procedural",
        "observation",
        "interpretation",
        "hypothesis",
        "warning",
        "constraint",
        "recommendation"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 3,
      "maxLength": 10000,
      "description": "Human-readable knowledge statement."
    },
    "language": {
      "$ref": "#/$defs/languageTag"
    },
    "status": {
      "type": "string",
      "enum": [
        "unreviewed",
        "source-linked",
        "source-backed",
        "automatically-verified",
        "human-reviewed",
        "disputed",
        "superseded",
        "invalidated"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Estimated confidence from 0 to 1. Confidence is not equivalent to human review or verified truth."
    },
    "source_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceId"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 100
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceId"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 500
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entityId"
      },
      "uniqueItems": true,
      "maxItems": 200
    },
    "concept_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conceptId"
      },
      "uniqueItems": true,
      "maxItems": 200
    },
    "relation_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationId"
      },
      "uniqueItems": true,
      "maxItems": 200
    },
    "conflict_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflictId"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "jurisdictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      },
      "uniqueItems": true,
      "maxItems": 50
    },
    "valid_from": {
      "$ref": "#/$defs/dateOrDateTime"
    },
    "valid_until": {
      "$ref": "#/$defs/dateOrDateTime"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "none",
            "automated",
            "human",
            "automated-and-human"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "human",
                  "automated-and-human"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "reviewer",
              "reviewed_at"
            ]
          }
        }
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claimId"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 100
    },
    "superseded_by": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claimId"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 100
    },
    "invalidation_reason": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "notes": {
      "type": "string",
      "maxLength": 3000
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension data using reverse-DNS keys.",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "source-linked",
              "source-backed",
              "automatically-verified",
              "human-reviewed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "source_ids"
            ]
          },
          {
            "required": [
              "evidence_ids"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "source-backed",
              "automatically-verified",
              "human-reviewed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "last_verified_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "automatically-verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "review"
        ],
        "properties": {
          "review": {
            "properties": {
              "method": {
                "enum": [
                  "automated",
                  "automated-and-human"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "human-reviewed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "review"
        ],
        "properties": {
          "review": {
            "properties": {
              "method": {
                "enum": [
                  "human",
                  "automated-and-human"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "disputed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "conflict_ids"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "superseded_by"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalidated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "invalidation_reason"
        ]
      }
    }
  ],
  "$defs": {
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47-style language tag."
    },
    "dateOrDateTime": {
      "oneOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "claimId": {
      "type": "string",
      "pattern": "^claim:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "sourceId": {
      "type": "string",
      "pattern": "^source:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^evidence:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "entityId": {
      "type": "string",
      "pattern": "^entity:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "conceptId": {
      "type": "string",
      "pattern": "^concept:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "relationId": {
      "type": "string",
      "pattern": "^relation:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    },
    "conflictId": {
      "type": "string",
      "pattern": "^conflict:[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "maxLength": 240
    }
  }
}
